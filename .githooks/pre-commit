#!/usr/bin/env bash
# Fast checks on every commit (AGENTS.md §4). Full verification runs on pre-push.
set -euo pipefail

max_kb=500
too_big=0
while IFS= read -r -d '' path; do
    size=$(git cat-file -s ":$path")
    if ((size > max_kb * 1024)); then
        echo "pre-commit: $path is $((size / 1024)) KB (limit ${max_kb} KB). Binaries and dumps don't belong in the repo." >&2
        too_big=1
    fi
done < <(git diff --cached --name-only --diff-filter=AM -z)
((too_big == 0)) || exit 1

if ! cargo fmt --all -- --check >/dev/null; then
    echo "pre-commit: code is not formatted. Run 'cargo fmt --all' and re-stage." >&2
    exit 1
fi
